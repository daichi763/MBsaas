+// companies.settings_json (JSON文字列) から真偽値設定を安全に読み取る
+function getCompanySetting(u: any, key: string, defaultValue: boolean): boolean {
+  try {
+    const s = JSON.parse(u.settings_json || '{}')
+    return typeof s[key] === 'boolean' ? s[key] : defaultValue
+  } catch {
+    return defaultValue
+  }
+}
