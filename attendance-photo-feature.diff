+      </div>`
+  }
+  return `
+    <div class="grid grid-cols-2 gap-2">
+      <button type="button" class="btn btn-outline" onclick="document.getElementById('photo-input-camera').click()">
+        <i class="fas fa-camera"></i>カメラで撮影
