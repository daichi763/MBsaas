{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:css && vite build",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/static/style.css --minify",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/run-tests.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mbsaas-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply mbsaas-production --remote --env production",
    "db:migrations:check": "node scripts/check-migrations.mjs",
    "db:seed:local": "wrangler d1 execute mbsaas-production --local --file=./seed.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs",
    "preview": "wrangler dev",
    "predeploy": "npm run typecheck && npm run db:migrations:check",
    "deploy": "npm run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.12.27",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.25.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "wrangler": "^4.127.1"
  }
}
