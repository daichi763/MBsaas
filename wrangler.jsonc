{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mbsaas",
	"compatibility_date": "2026-04-26",
	"main": "./dist/_worker.js",
	"assets": {
		"directory": "./dist"
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mbsaas-production",
			"database_id": "050d6fd5-7d49-4282-a0bf-f2b47981d086"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "mbsaas-attendance-photos"
		},
		{
			"binding": "DOCUMENTS",
			"bucket_name": "mbsaas-staff-documents"
		}
	],
	"triggers": {
		"crons": ["0 18 * * *"]
	}
}
